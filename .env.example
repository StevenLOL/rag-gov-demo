# 复制为 .env 按需修改；全部有默认值，v1 不配置也能跑

# 本地 LLM（Ollama 兼容）地址；不可达时自动降级为抽取式引用模式
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 拒答判定：查询词元在语料中的覆盖率低于该值 → 拒答（0~1）
REFUSAL_COVERAGE=0.5

# BM25 top1 分数低于该值 → 拒答（与覆盖率双保险）
RETRIEVAL_MIN_SCORE=2.0

# 检索后端：bm25 | vector（FAISS）| hybrid（BM25+向量 RRF 融合）
RETRIEVAL_BACKEND=bm25
# 本地嵌入模型（首次使用会下载；国内建议先 export HF_ENDPOINT=https://hf-mirror.com）
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
# 向量模式拒答阈值（余弦）
VECTOR_MIN_SCORE=0.35

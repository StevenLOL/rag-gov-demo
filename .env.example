# Copy to .env and adjust as needed; everything has a default value, so v1 runs even without configuration

# Local LLM (Ollama-compatible) endpoint; automatically falls back to extractive-quote mode when unreachable
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Refusal judgment: if the query token coverage in the corpus is below this value → refuse (0~1)
REFUSAL_COVERAGE=0.5

# If the BM25 top1 score is below this value → refuse (double safeguard alongside coverage)
RETRIEVAL_MIN_SCORE=2.0

# Retrieval backend: bm25 | vector (FAISS) | hybrid (BM25 + vector RRF fusion)
RETRIEVAL_BACKEND=bm25
# Local embedding model (downloaded on first use; in China, export HF_ENDPOINT=https://hf-mirror.com first is recommended)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
# Refusal threshold in vector mode (cosine)
VECTOR_MIN_SCORE=0.35
